{
  "name": "notagil/integration-sdk",
  "description": "PHP SDK for the NotaAgil public integration API.",
  "type": "library",
  "license": "MIT",
  "homepage": "https://github.com/sabbajohn/notagil-integration-sdk",
  "keywords": [
    "notagil",
    "fiscal",
    "nfe",
    "nfce",
    "nfse",
    "sdk"
  ],
  "authors": [
    {
      "name": "Sabba Sistemas"
    }
  ],
  "support": {
    "issues": "https://github.com/sabbajohn/notagil-integration-sdk/issues",
    "source": "https://github.com/sabbajohn/notagil-integration-sdk"
  },
  "require": {
    "php": "^8.2",
    "guzzlehttp/guzzle": "^7.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0"
  },
  "autoload": {
    "psr-4": {
      "NotaAgil\\Integration\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "NotaAgil\\Integration\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit"
  },
  "minimum-stability": "stable",
  "suggest": {
    "laravel/framework": "^12.0 enables the optional opt-in provisioning bridge; not required by the PHP client."
  },
  "extra": {
    "laravel": {
      "providers": [
        "NotaAgil\\Integration\\Laravel\\NotaAgilServiceProvider"
      ]
    }
  }
}
